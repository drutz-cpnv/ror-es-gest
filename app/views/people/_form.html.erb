<%= form_with(model: person, class: "max-w-2xl mx-auto bg-white rounded-lg shadow-sm") do |form| %>
  <div class="p-6 space-y-6">
    <div>
      <h3 class="text-xl text-gray-800 font-medium">User Information</h3>
      <p class="mt-1 text-sm text-gray-500">Please fill in all required information.</p>
    </div>

    <div class="space-y-4">
      <div>
        <%= form.label :email, class: "text-sm text-gray-600" %>
        <div class="mt-1">
          <%= form.email_field :email, class: "mt-1 block w-full px-3 py-2 text-gray-600 bg-white border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-400 focus:border-indigo-400 transition duration-150" %>
        </div>
        <% if person.errors[:email].any? %>
          <p class="mt-1 text-sm text-rose-500"><%= person.errors[:email].join(", ") %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password, class: "text-sm text-gray-600" %>
        <div class="mt-1">
          <%= form.password_field :password, class: "mt-1 block w-full px-3 py-2 text-gray-600 bg-white border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-400 focus:border-indigo-400 transition duration-150" %>
        </div>
        <% if person.errors[:password].any? %>
          <p class="mt-1 text-sm text-rose-500"><%= person.errors[:password].join(", ") %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password_confirmation, class: "text-sm text-gray-600" %>
        <div class="mt-1">
          <%= form.password_field :password_confirmation, class: "mt-1 block w-full px-3 py-2 text-gray-600 bg-white border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-400 focus:border-indigo-400 transition duration-150" %>
        </div>
      </div>

      <div>
        <%= form.label :type, class: "text-sm text-gray-600" %>
        <div class="mt-1">
          <%= form.select :type, Person.types, {}, class: "mt-1 block w-full px-3 py-2 text-gray-600 bg-white border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-400 focus:border-indigo-400 transition duration-150" %>
        </div>
        <% if person.errors[:type].any? %>
          <p class="mt-1 text-sm text-rose-500"><%= person.errors[:type].join(", ") %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :status_id, "Status", class: "text-sm text-gray-600" %>
        <div class="mt-1">
          <%= form.collection_select :status_id, Status.all, :id, :title, {}, class: "mt-1 block w-full px-3 py-2 text-gray-600 bg-white border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-400 focus:border-indigo-400 transition duration-150" %>
        </div>
      </div>

      <div>
        <%= form.label :address_id, "Address", class: "text-sm text-gray-600" %>
        <div class="mt-1">
          <%= form.collection_select :address_id, Address.all, :id, :full_address, {}, class: "mt-1 block w-full px-3 py-2 text-gray-600 bg-white border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-400 focus:border-indigo-400 transition duration-150" %>
        </div>
      </div>
    </div>
  </div>

  <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 rounded-b-lg flex justify-end space-x-3">
    <%= link_to "Cancel", people_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-700 bg-white border border-gray-200 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-1 focus:ring-gray-400 focus:border-gray-400 transition duration-150" %>
    <%= form.submit class: "px-4 py-2 text-sm text-white bg-indigo-500 hover:bg-indigo-600 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 transition duration-150" %>
  </div>
<% end %>
