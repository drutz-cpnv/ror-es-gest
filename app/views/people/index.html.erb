<% content_for :page_header do %>
  <h1 class="text-2xl font-semibold text-gray-900">People</h1>
  <%= link_to "Add person", new_person_path,
              class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
<% end %>

<div class="flex flex-col">
  <div class="overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
      <div class="overflow-hidden md:rounded-lg">

        <% content_for :header do %>
          <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Email</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
          <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
            <span class="sr-only">Actions</span>
          </th>
        <% end %>


        <% content_for :body do %>
          <% if @people.any? %>
            <% @people.each do |person| %>
              <tr class="hover:bg-gray-50">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                  <%= person.email %> (<%= person.type %>)
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= person.status&.title %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                  <div class="flex justify-end gap-2">
                    <%= link_to "Edit", edit_person_path(person), class: "text-blue-600 hover:text-blue-900" %>
                    <%= button_to "Delete", person_path(person),
                                  method: :delete,
                                  class: "text-red-600 hover:text-red-900",
                                  data: { turbo_confirm: "Are you sure?" },
                                  form: { class: 'inline-block' } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% end %>

        <%= render "shared/table" %>
      </div>
    </div>
  </div>
</div>
