<% content_for :title, "Grades" %>

<div class="p-6 max-w-[90rem] mx-auto">
  <% if notice.present? %>
    <div class="mb-6">
      <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    </div>
  <% end %>

  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Grades</h1>
    <%= link_to "New grade", new_grade_path,
                class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
  </div>

  <% content_for :header do %>
    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Student</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Grade</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Date</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Examination</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Subject</th>
    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
      <span class="sr-only">Actions</span>
    </th>
  <% end %>

  <% content_for :body do %>
    <% if @grades.any? %>
      <% @grades.each do |grade| %>
        <tr class="hover:bg-gray-50">
          <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
            <%= "#{grade.student&.lastname} #{grade.student&.firstname}" %>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm font-medium">
            <span class="<%= grade.value >= 4 ? 'text-green-600' : 'text-red-600' %>">
              <%= grade.value %>
            </span>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <%= grade.execute_on&.strftime("%d %b %Y") %>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <%= grade.examination&.title %>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">
              <%= grade.examination&.course&.subject&.name %>
            </span>
          </td>
          <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
            <div class="flex justify-end gap-2">
              <%= link_to "View", grade, class: "text-blue-600 hover:text-blue-900" %>
              <%= link_to "Edit", edit_grade_path(grade), class: "text-blue-600 hover:text-blue-900" %>
              <%= button_to "Delete", grade,
                          method: :delete,
                          class: "text-red-600 hover:text-red-900",
                          data: { turbo_confirm: "Are you sure?" },
                          form: { class: 'inline-block' } %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>

  <%= render "shared/table" %>

  <% if @grades.empty? %>
    <div class="text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No grades</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating a new grade.</p>
      <div class="mt-6">
        <%= link_to new_grade_path, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/>
          </svg>
          New Grade
        <% end %>
      </div>
    </div>
  <% end %>
</div>
