<% content_for :title, "Rooms" %>

<div class="p-6 max-w-[90rem] mx-auto">
  <% if notice.present? %>
    <div class="mb-6">
      <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    </div>
  <% end %>

  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Rooms</h1>
    <%= link_to "New room", new_room_path, 
        class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
  </div>

  <% content_for :header do %>
    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Room</th>
    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
      <span class="sr-only">Actions</span>
    </th>
  <% end %>

  <% content_for :body do %>
    <% if @rooms.any? %>
      <% @rooms.each do |room| %>
        <tr class="hover:bg-gray-50">
          <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
            <span>
              <%= room.name %>
            </span>
          </td>
          <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
            <div class="flex justify-end gap-2">
              <%= link_to "View", room, class: "text-blue-600 hover:text-blue-900" %>
              <%= link_to "Edit", edit_room_path(room), class: "text-blue-600 hover:text-blue-900" %>
              <%= button_to "Delete", room, 
                  method: :delete,
                  class: "text-red-600 hover:text-red-900",
                  form: { class: 'inline-block' } %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>

  <%= render "shared/table" %>

  <% if @rooms.empty? %>
    <div class="text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No rooms</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating a new room.</p>
      <div class="mt-6">
        <%= link_to new_room_path, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          New Room
        <% end %>
      </div>
    </div>
  <% end %>
</div>
