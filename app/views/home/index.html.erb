<%# Set the page title %>
<% content_for :page_title, "Dashboard" %>

<div class="pb-6 sm:pb-8 lg:pb-12">
  <div class="mx-auto max-w-screen-2xl">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      <%# Total Students Stats %>
      <div class="bg-white px-4 py-6 shadow-lg shadow-gray-200 rounded-lg">
        <div class="flex items-start">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium leading-6 text-gray-600">Total Students</p>
            <p class="mt-2 flex items-baseline gap-x-2">
              <span class="text-3xl font-semibold tracking-tight text-gray-900"><%= Student.count rescue 0 %></span>
            </p>
          </div>
        </div>
      </div>

      <%# Active Courses Stats %>
      <div class="bg-white px-4 py-6 shadow-lg shadow-gray-200 rounded-lg">
        <div class="flex items-start">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium leading-6 text-gray-600">Active Courses</p>
            <p class="mt-2 flex items-baseline gap-x-2">
              <span class="text-3xl font-semibold tracking-tight text-gray-900"><%= Course.count rescue 0 %></span>
            </p>
          </div>
        </div>
      </div>

      <%# School Classes Stats %>
      <div class="bg-white px-4 py-6 shadow-lg shadow-gray-200 rounded-lg">
        <div class="flex items-start">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium leading-6 text-gray-600">School Classes</p>
            <p class="mt-2 flex items-baseline gap-x-2">
              <span class="text-3xl font-semibold tracking-tight text-gray-900"><%= SchoolClass.count rescue 0 %></span>
            </p>
          </div>
        </div>
      </div>

      <%# Recent Grades Stats %>
      <% if can? :read, Grade %>
        <div class="bg-white px-4 py-6 shadow-lg shadow-gray-200 rounded-lg">
          <div class="flex items-start">
            <div class="p-3 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium leading-6 text-gray-600">Recent Grades</p>
              <p class="mt-2 flex items-baseline gap-x-2">
                <span class="text-3xl font-semibold tracking-tight text-gray-900"><%= Grade.where('created_at > ?', 1.week.ago).count rescue 0 %></span>
                <span class="text-sm text-gray-600">last 7 days</span>
              </p>
            </div>
          </div>
        </div>
      <% end %>


    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%# Recent Activity %>
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-100">
      <h3 class="text-lg font-semibold text-gray-800">Recent Activity</h3>
    </div>
    <div class="p-6">
      <div class="space-y-4">
        <% if can? :read, Grade %>
          <% grades = current_person.student? ? Grade.where(student_id: current_person.id) : Grade.all %>
          <% grades.order(created_at: :desc).limit(5).each do |grade| %>
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <p class="text-sm text-gray-600">New grade added for <%= grade.student&.full_name rescue 'Unknown Student' %></p>
                <p class="text-xs text-gray-400"><%= time_ago_in_words(grade.created_at) %> ago</p>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-600">You don't have permission to view grades.</p>
        <% end %>
      </div>
    </div>
  </div>

  <%# Quick Actions %>
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-100">
      <h3 class="text-lg font-semibold text-gray-800">Quick Actions</h3>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-2 gap-4">
        <% if can? :create, Person %>
          <%= link_to new_person_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Student</span>
          <% end %>
        <% end %>

        <% if can? :create, Course %>
          <%= link_to new_course_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Course</span>
          <% end %>
        <% end %>

        <% if can? :create, Grade %>
          <%= link_to new_grade_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Grade</span>
          <% end %>
        <% end %>

        <% if can? :create, Examination %>
          <%= link_to new_examination_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Examination</span>
          <% end %>
        <% end %>

        <% if can? :create, SchoolClass %>
          <%= link_to new_school_class_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Class</span>
          <% end %>
        <% end %>

        <% if can? :create, Subject %>
          <%= link_to new_subject_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Subject</span>
          <% end %>
        <% end %>

        <% if can? :create, Moment %>
          <%= link_to new_moment_path, class: "flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100" do %>
            <div class="p-2 rounded-full bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="ml-3 text-sm font-medium text-gray-700">Add Moment</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
