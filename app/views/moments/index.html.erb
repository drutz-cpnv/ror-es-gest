<% content_for :title, "Moments" %>

<div class="p-6 max-w-[90rem] mx-auto" x-data="{ activeTab: 'timeline' }">
  <% if notice.present? %>
    <div class="mb-6">
      <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    </div>
  <% end %>

  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Moments</h1>
    <%= link_to "New moment", new_moment_path, 
        class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
  </div>

  <div class="mb-6">
    <div class="tabs flex border-b border-gray-200">
      <button id="timeline-tab" 
              class="py-3 px-4 font-medium text-sm"
              :class="activeTab === 'timeline' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-500 hover:text-gray-700'"
              @click="activeTab = 'timeline'">
        Timeline
      </button>
      <button id="table-tab" 
              class="py-3 px-4 font-medium text-sm"
              :class="activeTab === 'table' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-500 hover:text-gray-700'"
              @click="activeTab = 'table'">
        Tableau
      </button>
      <button id="gantt-tab" 
              class="py-3 px-4 font-medium text-sm"
              :class="activeTab === 'gantt' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-500 hover:text-gray-700'"
              @click="activeTab = 'gantt'">
        Gantt
      </button>
    </div>
  </div>

  <div id="timeline-view" class="mb-10" x-show="activeTab === 'timeline'">
    <%= render "shared/timeline", years: @years %>
  </div>

  <div id="table-view" x-show="activeTab === 'table'">
    <% content_for :header do %>
      <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">UID</th>
      <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Type</th>
      <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Period</th>
      <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Duration</th>
      <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
        <span class="sr-only">Actions</span>
      </th>
    <% end %>

    <% content_for :body do %>
      <% if @moments.any? %>
        <% @moments.each do |moment| %>
          <tr class="hover:bg-gray-50">
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
              <%= moment.uid %>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
              <% type_colors = {
                'year' => 'bg-amber-50 text-amber-700 ring-amber-700/10',
                'semester' => 'bg-blue-50 text-blue-700 ring-blue-700/10',
                'quarter' => 'bg-green-50 text-green-700 ring-green-700/10'
              } %>
              <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= type_colors[moment.moment_type] || 'bg-gray-50 text-gray-700 ring-gray-700/10' %>">
                <%= moment.moment_type&.titleize %>
              </span>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
              <%= "#{moment.start_on&.strftime("%d %b %Y")} - #{moment.end_on&.strftime("%d %b %Y")}" %>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
              <%= pluralize((moment.end_on - moment.start_on).to_i, "day") if moment.start_on && moment.end_on %>
            </td>
            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
              <div class="flex justify-end gap-2">
                <%= link_to "View", moment, class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "Edit", edit_moment_path(moment), class: "text-blue-600 hover:text-blue-900" %>
                <%= button_to "Delete", moment, 
                    method: :delete,
                    class: "text-red-600 hover:text-red-900",
                    data: { turbo_confirm: "Are you sure?" },
                    form: { class: 'inline-block' } %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>

    <%= render "shared/table" %>

    <% if @moments.empty? %>
      <div class="text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-gray-900">No moments</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating a new moment.</p>
        <div class="mt-6">
          <%= link_to new_moment_path, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" do %>
            <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            New Moment
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div id="gantt-view" x-show="activeTab === 'gantt'" class="mb-10">
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Diagramme de Gantt</h3>
        
        <div class="overflow-x-auto">
          <div class="gantt-chart min-w-full" style="min-height: 400px;">
            <% if @moments.any? %>
              <div class="gantt-container">
                <div class="gantt-header flex border-b border-gray-200">
                  <div class="w-48 flex-shrink-0 py-2 px-3 bg-gray-50 font-medium text-sm text-gray-500">Moment</div>
                  <div class="flex-grow overflow-hidden">
                    <div class="flex">
                      <% 
                        # Determine date range for all moments
                        start_date = @moments.map(&:start_on).compact.min
                        end_date = @moments.map(&:end_on).compact.max
                        
                        # Default to current year if no moments or nil dates
                        if start_date.nil? || end_date.nil?
                          start_date = Date.today.beginning_of_year
                          end_date = Date.today.end_of_year
                        end
                        
                        # Add buffer to make sure all moments are fully visible
                        start_date = start_date.beginning_of_month
                        end_date = end_date.end_of_month
                        
                        # Calculate total days for positioning
                        total_days = (end_date - start_date).to_i + 1
                        
                        # Generate months for header
                        current_date = start_date.beginning_of_month
                        months = []
                        
                        while current_date <= end_date
                          months << current_date
                          current_date = current_date.next_month
                        end
                        
                        # Calculate width per day for consistent scaling
                        day_width_percent = 100.0 / total_days
                      %>
                      
                      <% months.each do |month| %>
                        <% 
                          # Calculate month width as percentage
                          days_in_month = month.end_of_month.day
                          month_width = days_in_month * day_width_percent
                        %>
                        <div class="text-center py-2 px-1 text-xs font-medium text-gray-500 -rotate-90 h-[80px] translate-x-8 translate-y-2 font-mono"
                             style="min-width: <%= month_width %>%; width: <%= month_width %>%">
                          <%= month.strftime("%m.%Y") %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
                
                <div class="gantt-body">
                  <% 
                    # Group moments by year
                    moments_by_year = {}
                    @moments.each do |moment|
                      if moment.start_on
                        year = moment.start_on.year
                        moments_by_year[year] ||= []
                        moments_by_year[year] << moment
                      end
                    end
                    
                    # Sort years in chronological order
                    sorted_years = moments_by_year.keys.sort
                  %>
                  
                  <% sorted_years.each do |year| %>
                    <div class="border-b border-gray-200 bg-gray-50">
                      <div class="flex">
                        <div class="w-48 flex-shrink-0 py-3 px-3 text-sm font-medium text-gray-700">
                          <%= year %>
                        </div>
                        <div class="flex-grow"></div>
                      </div>
                    </div>
                    
                    <% moments_by_year[year].each do |moment| %>
                      <div class="flex border-b border-gray-100 hover:bg-gray-50">
                        <div class="w-48 flex-shrink-0 py-3 px-3 pl-6 text-sm font-medium">
                          <%= moment.uid %>
                          <div class="text-xs text-gray-500"><%= moment.moment_type&.titleize %></div>
                        </div>
                        <div class="flex-grow relative py-3" style="height: 40px;">
                          <% 
                            if moment.start_on && moment.end_on
                              # Calculate position and width relative to the entire timeline
                              left_offset_days = [(moment.start_on - start_date).to_i, 0].max
                              right_cutoff_days = [(end_date - moment.end_on).to_i, 0].max
                              
                              # Calculate percentage values
                              left_percent = (left_offset_days.to_f / total_days * 100).round(2)
                              width_percent = (((total_days - left_offset_days - right_cutoff_days).to_f) / total_days * 100).round(2)
                              
                              # Ensure minimum width for visibility
                              width_percent = [width_percent, 0.5].max
                              
                              # Set color based on type
                              bar_colors = {
                                'year' => 'bg-amber-500',
                                'semester' => 'bg-blue-500',
                                'quarter' => 'bg-green-500'
                              }
                              bar_color = bar_colors[moment.moment_type] || 'bg-gray-500'
                          %>
                          
                          <div class="absolute h-6 rounded <%= bar_color %> opacity-80 hover:opacity-100 transition-opacity"
                               style="left: <%= left_percent %>%; width: <%= width_percent %>%; top: 8px;"
                               title="<%= "#{moment.uid}: #{moment.start_on&.strftime("%d %b %Y")} - #{moment.end_on&.strftime("%d %b %Y")}" %>">
                          </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <h3 class="mt-2 text-sm font-semibold text-gray-900">Aucun moment à afficher</h3>
                <p class="mt-1 text-sm text-gray-500">Créez des moments pour visualiser le diagramme de Gantt.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
