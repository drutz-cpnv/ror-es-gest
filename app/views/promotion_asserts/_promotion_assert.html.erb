<div id="<%= dom_id promotion_assert %>" class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
  <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
    <h3 class="text-lg font-medium leading-6 text-gray-900">
      <%= promotion_assert.description %>
    </h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">
      Function: <%= promotion_assert.moment.display_name %>
    </p>
  </div>
  <div class="border-t border-gray-200">
    <dl>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Description</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= promotion_assert.description %></dd>
      </div>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Function</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">
            <%= promotion_assert.function %>
          </span>
        </dd>
      </div>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Moment</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-700/10">
            <%= promotion_assert.moment_id %>
          </span>
        </dd>
      </div>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Sector</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
            <%= promotion_assert.sector_id %>
          </span>
        </dd>
      </div>
    </dl>
  </div>
</div>

<script type="module">
    document.addEventListener("turbo:load", function () {
        require.config({paths: {'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs'}});
        require(["vs/editor/editor.main"], function () {
            const editor = monaco.editor.create(document.getElementById("editor"), {
                value: "def is_promoted(grades)\n" +
                    "  return true\n" +
                    "end",
                language: "ruby",
                theme: "vs-light"
            });

            editor.onDidChangeModelContent(() => {
                const functionField = document.querySelector('textarea[name="promotion_assert[function]"]');
                if (functionField) {
                    functionField.value = editor.getValue();
                }
            });
        });
    })
</script>