<%= form_with(model: student_class, class: "contents") do |form| %>
  <% if student_class.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(student_class.errors.count, "error") %> prohibited this student_class from being saved:</h2>

      <ul class="list-disc ml-6">
        <% student_class.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :student_id %>
    <%= form.text_field :student_id, class: ["block shadow-sm rounded-md border outline-hidden px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": student_class.errors[:student_id].none?, "border-red-400 focus:outline-red-600": student_class.errors[:student_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :school_class_id %>
    <%= form.text_field :school_class_id, class: ["block shadow-sm rounded-md border outline-hidden px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": student_class.errors[:school_class_id].none?, "border-red-400 focus:outline-red-600": student_class.errors[:school_class_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
