<% content_for :title, "Student Classes" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Student Classes</h1>
    <%= link_to "New student class", new_student_class_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div class="min-w-full">
    <% if @student_classes.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-300">
          <thead>
            <tr class="bg-gray-50">
              <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Student</th>
              <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Class</th>
              <th class="relative py-3.5 pl-3 pr-4"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @student_classes.each do |student_class| %>
              <tr class="hover:bg-gray-50">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">
                  <%= "#{student_class.student&.lastname} #{student_class.student&.firstname}" %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= student_class.school_class&.name %></td>
                <td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium">
                  <%= link_to "Show", student_class, class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to "Edit", edit_student_class_path(student_class), class: "ml-3 text-blue-600 hover:text-blue-900" %>
                  <%= button_to "Delete", student_class, method: :delete, class: "ml-3 text-red-600 hover:text-red-900", form: { style: 'display: inline' } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10">No student classes found.</p>
    <% end %>
  </div>
</div>
