<% content_for :title, "Student classes" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Student classes</h1>
    <%= link_to "New student class", new_student_class_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="student_classes" class="min-w-full">
    <% if @student_classes.any? %>
      <% @student_classes.each do |student_class| %>
        <%= render student_class %>
        <p>
          <%= link_to "Show this student class", student_class, class: "ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
        </p>
      <% end %>
    <% else %>
      <p class="text-center my-10">No student classes found.</p>
    <% end %>
  </div>
</div>
