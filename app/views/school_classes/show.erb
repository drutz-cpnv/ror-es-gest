<% content_for :title, "#{@school_class.name}" %>

<div class="container mx-auto px-4 py-8">
  <div class="border-b border-gray-200 mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 leading-tight">
            <%= link_to @school_class.name, school_class_path(@school_class), class: "hover:text-indigo-600 hover:underline" %>
        </h1>
      </div>
      <div class="flex space-x-3">
        <%= link_to school_classes_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="mr-2 -ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back
        <% end %>
        <%= link_to edit_school_class_path(@school_class), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="mr-2 -ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        <% end %>
      </div>
    </div>
    <%= render 'class_details', school_class: @school_class, students: @students %>
  </div>

  <div x-data="{ 
    activeTab: 'students', 
    studentModal: false,
    courseModal: false,
    examinationModal: false
  }" class="mb-8">
    <!-- Navigation des onglets -->
    <%= render 'tabs_navigation' %>

    <!-- Onglet Liste des élèves -->
    <div x-show="activeTab === 'students'" class="mt-6">
      <%= render 'students_tab', school_class: @school_class, students: @students %>
    </div>

    <!-- Onglet Cours -->
    <div x-show="activeTab === 'courses'" class="mt-6">
      <%= render 'courses_tab', school_class: @school_class, courses: @courses, moments: @moments %>
    </div>

    <!-- Onglet Évaluations -->
    <div x-show="activeTab === 'examinations'" class="mt-6">
      <%= render 'examinations_tab', school_class: @school_class, examinations: @examinations, subjects: @subjects, moments: @moments %>
    </div>

    <!-- Onglet Bulletin de notes -->
    <div x-show="activeTab === 'grades'" class="mt-6">
      <%= render 'grades_tab', school_class: @school_class, students: @students, grades_by_student: @grades_by_student %>
    </div>

    <!-- Onglet Enseignants -->
    <div x-show="activeTab === 'teachers'" class="mt-6">
      <%= render 'teachers_tab', school_class: @school_class, teachers: @teachers %>
    </div>
  
    <!-- Modales -->
    <%= render 'student_modal', school_class: @school_class, students: @students %>
    <%= render 'course_modal', school_class: @school_class, subjects: Subject.all, teachers: Teacher.all, moments: @moments %>
    <%= render 'examination_modal', school_class: @school_class, courses: @courses %>
  </div>
</div>

<%= render 'filters_script' %> 