<% content_for :title, "School Classes" %>

<div class="p-6 max-w-[90rem] mx-auto">
  <% if notice.present? %>
    <div class="mb-6">
      <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    </div>
  <% end %>

  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">School Classes</h1>
    <%= link_to "New school class", new_school_class_path, 
        class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
  </div>

  <% content_for :header do %>
    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Class</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Teacher</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Room</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Sector</th>
    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Period</th>
    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
      <span class="sr-only">Actions</span>
    </th>
  <% end %>

  <% content_for :body do %>
    <% if @school_classes.any? %>
      <% @school_classes.each do |school_class| %>
        <tr class="hover:bg-gray-50">
          <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
            <div class="flex flex-col">
              <span><%= school_class.name %></span>
              <span class="text-xs text-gray-500"><%= school_class.uid %></span>
            </div>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <div class="flex items-center">
              <div class="h-8 w-8 flex-shrink-0 rounded-full bg-gray-100 flex items-center justify-center">
                <span class="text-xs font-medium text-gray-500">
                  <%= school_class.teacher&.firstname&.first %><%= school_class.teacher&.lastname&.first %>
                </span>
              </div>
              <div class="ml-3">
                <div class="font-medium text-gray-900"><%= school_class.teacher&.lastname %></div>
                <div class="text-gray-500"><%= school_class.teacher&.firstname %></div>
              </div>
            </div>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">
              <%= school_class.room&.name %>
            </span>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
              <%= school_class.sector&.name %>
            </span>
          </td>
          <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
            <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-700/10">
              <%= school_class.moment&.uid %>
            </span>
          </td>
          <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
            <div class="flex justify-end gap-2">
              <%= link_to "View", school_class, class: "text-blue-600 hover:text-blue-900" %>
              <%= link_to "Edit", edit_school_class_path(school_class), class: "text-blue-600 hover:text-blue-900" %>
              <%= button_to "Delete", school_class, 
                  method: :delete,
                  class: "text-red-600 hover:text-red-900",
                  data: { turbo_confirm: "Are you sure?" },
                  form: { class: 'inline-block' } %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>

  <%= render "shared/table" %>

  <% if @school_classes.empty? %>
    <div class="text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No school classes</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating a new school class.</p>
      <div class="mt-6">
        <%= link_to new_school_class_path, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          New School Class
        <% end %>
      </div>
    </div>
  <% end %>
</div>
