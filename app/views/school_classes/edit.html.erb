<% content_for :title, "Editing school class" %>

<div class="max-w-4xl mx-auto py-8">
  <div class="mb-8 flex items-center">
    <%= link_to courses_path, class: "mr-4 text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
    <% end %>
    <h1 class="text-2xl text-gray-800 font-medium">Edit course</h1>
  </div>

  <div class="">
    <%= render "form", school_class: @school_class %>
  </div>
</div>